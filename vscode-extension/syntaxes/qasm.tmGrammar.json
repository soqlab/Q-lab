{
  "name": "OpenQASM",
  "scopeName": "source.qasm",
  "patterns": [
    {
      "match": "\\b(OPENQASM|include|qreg|creg|gate|measure|barrier|reset|if)\\b",
      "name": "keyword.control.qasm"
    },
    {
      "match": "\\b(h|cx|x|y|z|s|t|rx|ry|rz|u1|u2|u3|ccx|swap|cz|cu1|cu3|id|tdg|sdg|p|cp|sx|sxdg|rxx|ryy|rzz|ecr)\\b",
      "name": "entity.name.function.qasm"
    },
    {
      "match": "//.*$",
      "name": "comment.line.qasm"
    },
    {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.qasm"
    },
    {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.qasm"
    },
    {
      "match": "\\b(pi|euler_gamma|tau)\\b",
      "name": "constant.language.qasm"
    }
  ]
}
