# Q-Lab production environment variables
# Copy to .env and fill in the values

# Database password (strong random string)
POSTGRES_PASSWORD=change_me_to_a_random_secret_string

# JWT signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_64_char_hex_secret

# Public URL of the frontend (no trailing slash)
FRONTEND_URL=https://qlab.yourcompany.com

# Optional: set to your production domain for CORS
ALLOWED_ORIGINS=https://qlab.yourcompany.com

# Anthropic API key — enables AI Insight Engine on run detail pages
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for insights (default: claude-haiku-4-5-20251001)
# Use claude-sonnet-4-6 for higher quality at higher cost
# QLAB_INSIGHT_MODEL=claude-haiku-4-5-20251001
