# Q-Lab — environment variables
# Copy to .env and fill in the required values

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL password
POSTGRES_PASSWORD=change_me_to_a_random_string

# JWT signing key — generate with:  python -c "import secrets; print(secrets.token_hex(32))"
QLAB_SECRET_KEY=change_me_to_a_64_char_hex_string

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL of your frontend (used for CORS and email links)
QLAB_APP_URL=https://qlab.yourdomain.com

# CORS allowed origins (comma-separated if multiple)
CORS_ORIGINS=https://qlab.yourdomain.com

# SMTP — enables email verification and password reset
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── AI keys (not needed here) ─────────────────────────────────────────────────
# Users add their own AI provider keys via Settings → Credentials inside the app.
# No server-side AI key is required.
