# HTTPS with the company's own certificate: tls/cert.pem (full chain) and tls/key.pem.
# No ACME, no Let's Encrypt, no outbound connection. Without those files, use the
# "tls internal" line instead and Caddy makes its own certificate (browsers will warn
# until its root, in the caddy-data volume, is trusted).
{
	auto_https disable_redirects
	skip_install_trust
}

{$SITE_ADDRESS} {
	tls /tls/cert.pem /tls/key.pem
	# tls internal

	encode zstd gzip
	# The web app also proxies /qlab-api to the API, so the SDK uses https://<address>/qlab-api.
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	header -Server
}

http://{$SITE_ADDRESS} {
	redir https://{host}{uri} 308
}
